# KODA — origin TLS + reverse proxy. Caddy auto-provisions a free Let's Encrypt
# certificate for your domain and forwards to the KODA container. Compression on.
# KODA_DOMAIN comes from the .env in this folder (e.g. kodajnn.com or pay.kodajnn.com).
{$KODA_DOMAIN} {
	encode zstd gzip
	reverse_proxy koda:8080
}

# www → apex: anyone typing www.kodajnn.com (or with it printed on a van) gets a
# permanent redirect to the canonical apex. Requires a DNS record for www pointing
# at this host so Caddy can provision its certificate.
www.{$KODA_DOMAIN} {
	redir https://{$KODA_DOMAIN}{uri} permanent
}
