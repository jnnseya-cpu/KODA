# KODA platform — environment template. Copy to .env / set in Secret Manager.
# ── core ──────────────────────────────────────────────────────────
PORT=4600
NODE_ENV=production
KODA_JWT_SECRET=              # REQUIRED in production — long random string
KODA_DATA_DIR=./data          # SQLite location (mount a volume in containers)
KODA_QUIET=                   # set 1 to silence access logs

# ── providers: leaving a var empty keeps that channel in sandbox ──
BREVO_API_KEY=                # transactional email (Brevo)
META_WA_TOKEN=                # WhatsApp Cloud API system-user token
META_WA_PHONE_ID=             # WhatsApp Business phone-number ID
META_API_VERSION=v20.0
META_WA_VERIFY_TOKEN=koda-verify   # must match Meta app webhook config
FCM_KEY=                      # Firebase Cloud Messaging (push)
SMS_GATEWAY_KEY=              # optional SMS fallback channel
