# KODA — environment template. Copy to .env for local dev, or set each key in
# your platform's secret manager for production. An EMPTY provider var keeps
# that channel in safe sandbox mode; the app still boots and the money path
# still works — only that specific external integration stays inert.
# ─────────────────────────────────────────────────────────────────────────────

# ── CORE (required in production) ────────────────────────────────────────────
NODE_ENV=production
PORT=8080                        # Cloud Run/Render inject their own; 4600 local
KODA_JWT_SECRET=                 # REQUIRED — long random string (openssl rand -hex 32).
                                 # Production refuses to boot on the dev default.
KODA_PUBLIC_URL=https://pay.kodajnn.com   # canonical public origin. Used to build
                                 # checkout_url links — MUST be the real domain in prod,
                                 # or customers get localhost checkout links.
KODA_DATA_DIR=/data              # SQLite location — mount a PERSISTENT volume here.
KODA_QUIET=                      # set 1 to silence per-request access logs

# ── ADMIN BOOTSTRAP (production seed) ────────────────────────────────────────
# In production the demo accounts are NOT seeded. The first admin is created
# from these two vars on first boot. Set them, boot once, then rotate.
KODA_ADMIN_EMAIL=
KODA_ADMIN_PASSWORD=
KODA_SEED_DEMO=                  # set 1 ONLY to force demo accounts in production (don't)

# ── AI GATEWAY (powers Growth Engine, agents, Vision, dispute evidence) ───────
# Any ONE of these enables the AI features; all are metered/gated by ACU.
# With none set, AI endpoints fall back to deterministic templates (still gated).
ANTHROPIC_API_KEY=               # Claude — primary
GEMINI_API_KEY=                  # Google Gemini — fallback / vision
OPENAI_API_KEY=                  # OpenAI — fallback

# ── WHATSAPP (Meta Cloud API) — Door 2 + notifications ───────────────────────
META_WA_TOKEN=                   # system-user permanent token
META_WA_PHONE_ID=                # WhatsApp Business phone-number ID
META_API_VERSION=v20.0
META_WA_VERIFY_TOKEN=koda-verify # must match the webhook "verify token" in the Meta app
META_APP_SECRET=                 # Meta App secret — verifies inbound webhook signatures.
                                 # Empty in dev = signature check skipped; SET IN PRODUCTION.

# ── TRANSACTIONAL EMAIL (Brevo) — receipts, invites, alerts ──────────────────
BREVO_API_KEY=                   # empty = emails render to log instead of sending

# ── PUSH / SMS FALLBACK (optional) ───────────────────────────────────────────
FCM_KEY=                         # Firebase Cloud Messaging — Sentinel app push
SMS_GATEWAY_KEY=                 # optional SMS fallback channel

# ═════════════════════════════════════════════════════════════════════════════
# BILLING RAILS — System B: how KODA collects its OWN plan & top-up revenue.
# (This never touches a merchant's customer money — that's the verify engine.)
# Every key here is OPTIONAL: with none set, plan checkout still offers the
# mobile-money rail (once you add a receiving number in Admin → Collection setup)
# and card rails simply show "coming soon". See docs/BILLING_RAILS.md.
# ═════════════════════════════════════════════════════════════════════════════

# App origin used to build checkout success/cancel + /billing/go redirect links.
# Defaults to KODA_PUBLIC_URL when unset — set only if the app lives on another host.
KODA_APP_URL=

# ── PLAN CHECKOUT: MOBILE MONEY (Door 3 — KODA's own engine, no third party) ──
# Preferred config is the admin console (Admin → Collection setup), which stores
# these in the DB and overrides the vars below. They remain as a boot-time fallback.
KODA_COLLECT_MSISDN=             # KODA's receiving mobile-money number (e.g. +243…)
KODA_COLLECT_MERCHANT=           # id of the KODA-owned merchant whose Sentinel holds that SIM
KODA_COLLECT_CURRENCY=CDF        # currency KODA actually receives in
KODA_USD_TO_LOCAL=2800           # pinned USD→local rate for the exact-amount auto-match

# ── PLAN CHECKOUT: CARD (Stripe) ─────────────────────────────────────────────
STRIPE_KEY=                      # sk_live_… / sk_test_… — enables the card rail on plan checkout
STRIPE_WEBHOOK_SECRET=           # whsec_… — verifies checkout.session.completed callbacks
                                 # Register: https://<domain>/webhooks/billing/stripe
STRIPE_CURRENCY=usd              # charge currency (lowercase)

# ── ACU TOP-UPS (billing mesh) — extra rails for prepaid credit, not plans ────
PAYSTACK_KEY=                    # sk_live_… / sk_test_… — cards/bank/MoMo (NG/GH/KE/ZA)
PAYSTACK_CURRENCY=NGN            # Paystack account currency
PAYSTACK_FX=1                    # USD→account-currency factor (1 = charge the USD figure as-is)
                                 # Webhook: https://<domain>/webhooks/billing/paystack
FLUTTERWAVE_KEY=                 # FLWSECK-… — pan-African cards + mobile money
FLUTTERWAVE_WEBHOOK_HASH=        # the "secret hash" you set in the Flutterwave dashboard;
                                 # sent back in the verif-hash header on each webhook
                                 # Webhook: https://<domain>/webhooks/billing/flutterwave
FLUTTERWAVE_CURRENCY=USD

# ── BUILD STAMP (set by CI at deploy) ────────────────────────────────────────
KODA_BUILD_SHA=                  # git commit — surfaced at GET /version
KODA_BUILD_DATE=                 # ISO deploy timestamp — surfaced at /version & status page

# ── TEST TOOLING (not needed in production) ──────────────────────────────────
# KODA_BASE=http://localhost:4600   # target for the HTTP test suites
# PW_CHROMIUM=/opt/pw-browsers/chromium  # browser path for UI/proof tests
