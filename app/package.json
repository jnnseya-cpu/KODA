{
  "name": "koda-platform",
  "version": "2.0.0",
  "description": "KODA \u2014 payment verification OS. The SMS is the API. Zero-dependency Node runtime.",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings backend/server.js",
    "dev": "node --no-warnings --watch backend/server.js",
    "bench": "node --no-warnings backend/tools/bench.js",
    "test": "node --no-warnings backend/tools/test.js && node --no-warnings backend/tools/test-operators.js && node --no-warnings backend/tools/margin.js",
    "test:ui": "node --no-warnings backend/tools/ui-test.js",
    "backup": "node --no-warnings backend/tools/backup.js",
    "margin": "node --no-warnings backend/tools/margin.js",
    "test:security": "node --no-warnings backend/tools/adversarial.js",
    "test:networks": "node --no-warnings backend/tools/test-networks.js",
    "test:billing": "node --no-warnings backend/tools/test-billing.js",
    "test:http": "node --no-warnings backend/tools/test-http.js",
    "test:all": "npm test && npm run test:networks && npm run test:billing && npm run test:http",
    "test:checkout": "node --no-warnings backend/tools/test-checkout.js",
    "test:doors": "node --no-warnings backend/tools/test-doors.js",
    "test:busy": "node --no-warnings backend/tools/test-busy-merchant.js",
    "test:growth": "node --no-warnings backend/tools/test-growth.js",
    "test:gating": "node --no-warnings backend/tools/test-ai-gating.js"
  }
}