<?xml version="1.0" encoding="utf-8"?>
<!-- SIDELOAD flavor: capture operator payments by reading the SMS directly.
     Uses the restricted SMS permissions, so this build is distributed OUTSIDE the
     Play Store (direct APK / kodajnn.com/sentinel). The `play` flavor uses a
     notification listener instead and carries none of these. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <application>
        <!-- fires on every incoming SMS -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
