<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/koda_ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/koda_gold"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textColor="@color/koda_paper"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="12dp"
            android:background="@color/koda_ink2"
            android:text="@string/not_paired"
            android:textColor="@color/koda_green"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- PAIR GROUP (shown when not paired) -->
        <LinearLayout
            android:id="@+id/pairGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_base"
                android:textColor="@color/koda_paper" />

            <EditText
                android:id="@+id/baseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/koda_paper"
                android:hint="https://kodajnn.com"
                android:autofillHints="url" />

            <Button
                android:id="@+id/scanBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/koda_gold"
                android:textColor="@color/koda_ink"
                android:text="@string/scan_qr" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/or_paste"
                android:textColor="@color/koda_paper" />

            <EditText
                android:id="@+id/token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/koda_paper"
                android:hint="dvk_… or koda://enroll/…?t=dvk_…"
                android:autofillHints="password" />

            <Button
                android:id="@+id/pairBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/koda_green"
                android:textColor="@color/koda_ink"
                android:text="@string/pair" />
        </LinearLayout>

        <!-- PAIRED GROUP (shown when paired) -->
        <LinearLayout
            android:id="@+id/pairedGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recent"
                android:textColor="@color/koda_paper"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@color/koda_ink2"
                android:fontFamily="monospace"
                android:textColor="@color/koda_paper"
                android:textSize="12sp"
                android:text="@string/no_sms" />

            <Button
                android:id="@+id/unpairBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/koda_danger"
                android:textColor="@color/koda_paper"
                android:text="@string/unpair" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
